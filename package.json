{
      "name": "decky-backlog-picker",
      "version": "1.2.4",
      "type": "module",
      "description": "Can't decide what to play? Let the Backlog Picker choose for you.",
      "scripts": {
            "build": "rollup -c",
            "dev": "rollup -c -w",
            "preview": "vite --config preview/vite.config.ts",
            "preview:backend": "python3 preview/backend_server.py"
      },
      "peerDependencies": {
            "react": "^17.0.2",
            "react-dom": "^17.0.2"
      },
      "devDependencies": {
            "@decky/api": "latest",
            "@decky/rollup": "^1.0.2",
            "@decky/ui": "latest",
            "@rollup/plugin-commonjs": "^25.0.0",
            "@rollup/plugin-json": "^6.0.0",
            "@rollup/plugin-node-resolve": "^15.0.0",
            "@rollup/plugin-replace": "^5.0.0",
            "@rollup/plugin-typescript": "^11.0.0",
            "@vitejs/plugin-react": "^4.7.0",
            "rollup": "^3.0.0",
            "tslib": "^2.0.0",
            "typescript": "^5.0.0",
            "vite": "^5.4.21"
      },
      "license": "MIT",
      "dependencies": {
            "react-icons": "^5.6.0"
